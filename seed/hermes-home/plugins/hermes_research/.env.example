# Hermes Research optional source configuration
#
# Copy only the variables you need into your private .env file. Do not commit
# real tokens, emails, provider keys or personal paths.

# Unpaywall uses a contact email, not a classic API key. Hermes keeps it out of
# logs, CSV files and publication packages.
HERMES_UNPAYWALL_EMAIL=your-contact-email@example.com

# Lens is optional. If unset, Hermes records Lens as skipped and continues.
HERMES_LENS_API_KEY=

# Optional specialist-source controls.
HERMES_ENABLE_EUROPEPMC=0
HERMES_ENABLE_PUBMED=0
HERMES_DISABLE_OPENAIRE=0
HERMES_DISABLE_LENS=0
HERMES_DISABLE_EUROPEPMC=0
HERMES_DISABLE_PUBMED=0
HERMES_ENABLE_ARXIV=0
HERMES_DISABLE_ARXIV=0
HERMES_DISABLE_SEMANTIC_SCHOLAR=0

# Optional API/contact settings for public scholarly sources.
HERMES_NCBI_EMAIL=
HERMES_NCBI_API_KEY=
HERMES_ENABLE_SEMANTIC_SCHOLAR=0
SEMANTIC_SCHOLAR_API_KEY=
