def network_analysis_needs_refresh(review_dir: Path) -> bool:
    """Rebuild the atlas when it is missing or older than its source evidence."""

    atlas = review_dir / "analysis" / "atlas" / "network-atlas.html"
    if not atlas.exists() or atlas.stat().st_size == 0:
        return True
    source_patterns = (
        "records/master-records.csv",
        "screening/*.csv",
        "extraction/extraction-table.csv",
        "searches/search-log.csv",
    )
    atlas_mtime = atlas.stat().st_mtime
    return any(
        path.stat().st_mtime > atlas_mtime
        for pattern in source_patterns
        for path in review_dir.glob(pattern)
        if path.is_file()
    )


def latest_review_dir(root: Path) -> Path | None:
    """Pick the most recently modified review directory as a safe fallback."""

    reviews = [
        child
        for child in root.iterdir()
        if child.is_dir() and child.name.startswith("systematic-review") and child.name != "systematic-review-template"
    ]
    if not reviews:
        return None
    reviews.sort(key=lambda item: item.stat().st_mtime, reverse=True)
    return reviews[0]


def resolve_review_dir(review: str | None, env: dict[str, str]) -> Path:
    """Resolve either an explicit review path/name or the latest workspace review."""

    root = workspace_root(env)
    if review:
        candidate = Path(review).expanduser()
        if candidate.exists():
            return candidate.resolve()
        candidate = root / review
        if candidate.exists():
            return candidate.resolve()
        raise SystemExit(f"Review not found: {review}")

    latest = latest_review_dir(root)
    if latest is None:
        raise SystemExit("No review directory was found in the configured workspace")
    return latest.resolve()


def build_pipeline_command(
    review_dir: Path,
    *,
    skip_publication_layer: bool,
    target_review_dir: str | None = None,
    target_script_root: str | None = None,
    target_plugin_root: str | None = None,
) -> list[str]:
    """Build the durable runner command shared by CLI and Telegram."""

    local_runner = SEEDED_HERMES_HOME / "plugins" / "hermes_research" / "job_runner.py"
    ensure_exists(local_runner, "research job runner")
    review_arg = target_review_dir or str(review_dir)
    scripts_root = target_script_root or str(prisma_script())
    runner = (
        str(Path(target_plugin_root) / "job_runner.py")
        if target_plugin_root
        else str(local_runner)
    )
    command = [
        "python3",
        "-u",
        runner,
        "--review-dir",
        review_arg,
        "--scripts-dir",
        scripts_root,
        "--job-id",
        uuid.uuid4().hex,
    ]
    if skip_publication_layer:
        command.append("--skip-publication-layer")
    return command


def prompt_text(prompt: str, *, default: str = "", required: bool = False) -> str:
    """Prompt for one field in the interactive intake wizard."""

    suffix = f" [{default}]" if default else ""
    while True:
        value = input(f"{prompt}{suffix}: ").strip()
        if value:
            return value
        if default:
            return default
        if not required:
            return ""
        print("This field is required.")


def validate_final_n(value: object) -> str:
    """Validate an exact final N or an inclusive range such as 23-63."""

    normalized = str(value).strip().replace("–", "-").replace("—", "-")
    match = re.fullmatch(r"(\d+)(?:\s*-\s*(\d+))?", normalized)
    if not match:
        raise SystemExit("Final N must be a positive integer or a range such as 23-63")
    lower = int(match.group(1))
    upper = int(match.group(2) or match.group(1))
    if lower < 1 or upper < lower:
        raise SystemExit("Final N range must be positive and ordered from minimum to maximum")
    return str(lower) if lower == upper else f"{lower}-{upper}"


def collect_init_payload(args: argparse.Namespace) -> dict[str, str]:
    """Collect the public intake either from flags or from an interactive wizard."""

    required_missing = [
        label for label, value in (
            ("topic", args.topic),
            ("years", args.years),
            ("include", args.include),
            ("exclude", args.exclude),
        )
        if not (value or "").strip()
    ]

    if required_missing:
        if not sys.stdin.isatty():
            missing = ", ".join(required_missing)
            raise SystemExit(
                "Missing required intake fields: "
                f"{missing}. Run `./hermes-research init` in a terminal for the guided wizard "
                "or pass the flags explicitly."
            )

        print("Hermes Research guided intake")
        print("Answer the four required fields first. Press Enter to accept defaults on optional fields.\n")
        args.topic = prompt_text("Topic", required=True)
        args.question = args.question or prompt_text("Research question (optional)")
        args.years = prompt_text("Year or year range", default="2025-2026", required=True)
        args.include = prompt_text("Inclusion criteria", required=True)
        args.exclude = prompt_text("Exclusion criteria", required=True)
        args.authors = args.authors or prompt_text("Author filter (optional)")
        args.from_date = args.from_date or prompt_text("Exact start date YYYY-MM-DD (optional)")
        args.to_date = args.to_date or prompt_text("Exact end date YYYY-MM-DD (optional)")
        args.autonomous = prompt_text("Autonomous mode", default=args.autonomous or "sí")
        final_n_value = prompt_text("Target final N", default=str(args.final_n or 37))
        args.final_n = validate_final_n(final_n_value)
        args.outlet = args.outlet or prompt_text("Target outlet", default="generic-common-core")
        args.representativeness = args.representativeness or prompt_text("Representativeness rule (optional)")
        args.target_length = args.target_length or prompt_text("Target manuscript length (optional)")
    else:
        args.final_n = validate_final_n(args.final_n)

    return {
        "topic": args.topic,
        "research_question": args.question or "",
        "year_or_years": args.years,
        "from_date": args.from_date or "",
        "to_date": args.to_date or "",
        "inclusion_criteria": args.include,
        "exclusion_criteria": args.exclude,
        "author_filters": args.authors or "",
        "autonomous_mode": args.autonomous,
        "final_n": str(args.final_n),
        "representativeness": args.representativeness or "",
        "target_outlet": args.outlet or "generic-common-core",
        "target_length": args.target_length or "",
    }


def render_init_summary(
    summary: dict[str, object],
    review_dir: Path,
    *,
    background_started: bool,
    pid_label: str,
) -> str:
    """Return a human-readable init summary for the public CLI."""

    lines = [
        f"I created the review `{summary['review_name']}` and materialized the initial protocol.",
        "",
        "Artifacts created",
        "- `protocol/intake.md`",
        "- `protocol/research-question.md`",
        "- `protocol/eligibility-criteria.md`",
        "- `protocol/search-strategy.md`",
        "- `notes/runtime-state.json`",
        "",
        f"Status: `{summary['status']}`",
        f"Next phase: `{summary['next_phase']}`",
        f"Next action: {summary['next_action']}",
    ]
    if background_started:
        lines.extend(
            [
                "",
                "Hermes is already continuing the review in the background.",
                f"- Durable job ledger: `{review_dir / 'notes' / 'job-ledger.json'}`",
                f"- Compatibility PID marker: `{review_dir / 'notes' / f'{pid_label}.pid'}`",
                f"- Log: `{review_dir / 'notes' / 'run.log'}`",
            ]
        )
    else:
        lines.extend(
            [
                "",
                "Autonomous continuation is off, so the review is waiting at the protocol stage.",
                f"Run `./hermes-research resume {review_dir.name}` to continue it.",
            ]
        )
    return "\n".join(lines) + "\n"


def launch_background(command: list[str], *, env: dict[str, str], review_dir: Path, label: str) -> int:
    """Start a background review command and persist a small PID marker."""

    notes_dir = review_dir / "notes"
    notes_dir.mkdir(parents=True, exist_ok=True)
    log_path = notes_dir / "run.log"
    pid_path = notes_dir / f"{label}.pid"
    with log_path.open("a", encoding="utf-8") as log_handle:
        proc = subprocess.Popen(  # noqa: S603
            command,
            cwd=str(review_dir.parent),
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            env=env,
            start_new_session=True,
            close_fds=True,
        )
    pid_path.write_text(
        json.dumps(
            {
                "pid": proc.pid,
                "command": command,
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    print(f"Started background process for {review_dir.name} (PID {proc.pid})")
    print(f"Log: {log_path}")
    return 0


def run_in_container(command: list[str], *, env: dict[str, str], cwd: Path | None = None) -> int:
    """Run a foreground command inside the bundle's Docker runtime."""

    container = bundle_container_name(env)
    if not container:
        raise SystemExit("The public runtime container is not available for this command")
    container_command = ["docker", "exec"]
    if cwd:
        container_command.extend(["-w", str(cwd)])
    container_command.append(container)
    container_command.extend(command)
    return run_command(container_command, env=env)


def launch_background_in_container(
    command: list[str],
    *,
    env: dict[str, str],
    review_dir: Path,
    label: str,
    container_review_dir_path: str,
) -> int:
    """Start a background PRISMA command inside the running Docker runtime.

    This path is the safest public behavior when the bundle runtime is already
    up, because it avoids leaking image dependencies such as SVG rendering tools
    onto the user's host machine.
    """

    container = bundle_container_name(env)
    if not container:
        raise SystemExit("The public runtime container is not available for this command")

    notes_dir = review_dir / "notes"
    notes_dir.mkdir(parents=True, exist_ok=True)
    log_path = notes_dir / "run.log"
    pid_path = notes_dir / f"{label}.pid"
    result = subprocess.run(
        ["docker", "exec", "-d", "-w", "/workspace", container, *command],
        text=True,
        capture_output=True,
        env=env,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr or result.stdout or "Failed to launch the background container command")
    pid_path.write_text(
        json.dumps(
            {
                "pid": None,
                "transport": "docker-exec",
                "container": container,
                "ledger": f"{container_review_dir_path}/notes/job-ledger.json",
                "command": command,
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    print(f"Started background process for {review_dir.name} inside {container}")
    print(f"Log: {log_path}")
    return 0


def command_doctor(_: argparse.Namespace, env: dict[str, str]) -> int:
    """Run the public package installation checks."""

    return run_command(["bash", str(PACKAGE_ROOT / "scripts" / "doctor.sh")], env=env, cwd=PACKAGE_ROOT)


def command_setup(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Run the secret-safe installation wizard."""

    command = ["bash", str(PACKAGE_ROOT / "scripts" / "setup.sh")]
    if args.non_interactive:
        command.append("--non-interactive")
    return run_command(command, env=env, cwd=PACKAGE_ROOT)


def compose_command(arguments: list[str], env: dict[str, str]) -> int:
    """Run Docker Compose against the package's only public compose file."""

    return run_command(
        ["docker", "compose", "-f", str(PACKAGE_ROOT / "docker-compose.research.yml"), *arguments],
        env=env,
        cwd=PACKAGE_ROOT,
    )


def command_up(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Build and start the public runtime."""

    doctor_result = command_doctor(args, env)
    if doctor_result != 0:
        return doctor_result
    command = ["up", "-d", "--build"]
    if not args.without_docling:
        command[0:0] = ["--profile", "docling"]
    return compose_command(command, env)


def command_down(_: argparse.Namespace, env: dict[str, str]) -> int:
    """Stop containers without deleting bind-mounted research data."""

    return compose_command(["--profile", "docling", "down"], env)


def command_logs(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Follow bounded runtime logs."""

    command = ["--profile", "docling", "logs", "--tail", str(args.tail)]
    if args.follow:
        command.append("--follow")
    return compose_command(command, env)


