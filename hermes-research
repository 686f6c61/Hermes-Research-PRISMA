def command_init(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Create a new review from a small public-facing intake."""

    script = prisma_script("bootstrap_public_intake.py")
    ensure_exists(script, "public intake bootstrap script")
    payload = collect_init_payload(args)

    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False)
        intake_json = handle.name

    try:
        result = subprocess.run(
            [
                "python3",
                str(script),
                "--workspace-root",
                str(workspace_root(env)),
                "--intake-json",
                intake_json,
            ],
            text=True,
            capture_output=True,
            check=False,
            env=env,
        )
    finally:
        Path(intake_json).unlink(missing_ok=True)

    if result.returncode != 0:
        sys.stderr.write(result.stderr or result.stdout or "init failed\n")
        return result.returncode

    summary = json.loads((result.stdout or "").strip().splitlines()[-1])
    review_dir = Path(str(summary["review_dir"])).resolve()
    background_started = False
    pid_label = "public-autonomous"
    if is_truthy(str(summary.get("autonomous_mode", ""))):
        container_name = bundle_container_name(env)
        command = build_pipeline_command(
            review_dir,
            skip_publication_layer=False,
            target_review_dir=container_review_dir(review_dir, env) if container_name else None,
            target_script_root=(
                str(Path("/opt/data") / "skills" / "research" / "prisma-systematic-review" / "scripts")
                if container_name
                else None
            ),
        )
        if container_name:
            launch_background_in_container(
                command,
                env=env,
                review_dir=review_dir,
                label=pid_label,
                container_review_dir_path=container_review_dir(review_dir, env),
            )
        else:
            launch_background(command, env=env, review_dir=review_dir, label=pid_label)
        background_started = True

    sys.stdout.write(
        render_init_summary(
            summary,
            review_dir,
            background_started=background_started,
            pid_label=pid_label,
        )
    )
    return 0


def command_status(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Print the current status for one review or for the latest workspace review."""

    script = prisma_status_script()
    ensure_exists(script, "PRISMA status script")
    command = [
        "python3",
        str(script),
        "--workspace-root",
        str(workspace_root(env)),
        "--format",
        args.format,
    ]
    if args.review:
        command.insert(2, str(resolve_review_dir(args.review, env)))
    return run_command(command, env=env)


def command_run(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Run the PRISMA pipeline for a review in foreground or background."""

    review_dir = resolve_review_dir(args.review, env)
    container_name = bundle_container_name(env)
    if container_name:
        command = build_pipeline_command(
            review_dir,
            skip_publication_layer=args.skip_publication_layer,
            target_review_dir=container_review_dir(review_dir, env),
            target_script_root=str(Path("/opt/data") / "skills" / "research" / "prisma-systematic-review" / "scripts"),
        )
    else:
        command = build_pipeline_command(review_dir, skip_publication_layer=args.skip_publication_layer)
    if args.background:
        if container_name:
            return launch_background_in_container(
                command,
                env=env,
                review_dir=review_dir,
                label="cli-run",
                container_review_dir_path=container_review_dir(review_dir, env),
            )
        return launch_background(command, env=env, review_dir=review_dir, label="cli-run")
    if container_name:
        return run_in_container(command, env=env, cwd=Path("/workspace"))
    return run_command(command, env=env, cwd=review_dir.parent)


def command_resume(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Resume the review pipeline, defaulting to background mode."""

    review_dir = resolve_review_dir(args.review, env)
    container_name = bundle_container_name(env)
    if container_name:
        command = build_pipeline_command(
            review_dir,
            skip_publication_layer=args.skip_publication_layer,
            target_review_dir=container_review_dir(review_dir, env),
            target_script_root=str(Path("/opt/data") / "skills" / "research" / "prisma-systematic-review" / "scripts"),
        )
    else:
        command = build_pipeline_command(review_dir, skip_publication_layer=args.skip_publication_layer)
    if args.foreground:
        if container_name:
            return run_in_container(command, env=env, cwd=Path("/workspace"))
        return run_command(command, env=env, cwd=review_dir.parent)
    if container_name:
        return launch_background_in_container(
            command,
            env=env,
            review_dir=review_dir,
            label="cli-resume",
            container_review_dir_path=container_review_dir(review_dir, env),
        )
    return launch_background(command, env=env, review_dir=review_dir, label="cli-resume")


def command_package(args: argparse.Namespace, env: dict[str, str]) -> int:
    """Refresh the final bundle for a prepared review."""

    review_dir = resolve_review_dir(args.review, env)
    container_name = bundle_container_name(env)
    container_dir = container_review_dir(review_dir, env) if container_name else ""
    package_script = prisma_script("package_publication_bundle.py")
    ensure_exists(package_script, "publication bundle script")

    if args.autopilot:
        autopilot_script = prisma_script("publication_autopilot.py")
        ensure_exists(autopilot_script, "publication autopilot script")
        autopilot_command = (
            ["python3", container_prisma_script("publication_autopilot.py"), container_dir]
            if container_name
            else ["python3", str(autopilot_script), str(review_dir)]
        )
        returncode = run_in_container(autopilot_command, env=env, cwd=Path("/workspace")) if container_name else run_command(
            autopilot_command,
            env=env,
            cwd=review_dir.parent,
        )
        if returncode != 0:
            return returncode

    package_command = (
        ["python3", container_prisma_script("package_publication_bundle.py"), container_dir]
        if container_name
        else ["python3", str(package_script), str(review_dir)]
    )
    if container_name:
        return run_in_container(package_command, env=env, cwd=Path("/workspace"))
    return run_command(
        package_command,
        env=env,
        cwd=review_dir.parent,
    )


def build_parser() -> argparse.ArgumentParser:
    """Construct the public CLI surface for the research package."""

    parser = argparse.ArgumentParser(
        prog="hermes-research",
        description="Public command wrapper for Hermes Research Pack",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    setup = subparsers.add_parser("setup", help="Configure provider, models, and optional Telegram access")
    setup.add_argument("--non-interactive", action="store_true", help="Read every value from environment variables")
    setup.set_defaults(func=command_setup)

    doctor = subparsers.add_parser("doctor", help="Validate the installation")
    doctor.set_defaults(func=command_doctor)

    up = subparsers.add_parser("up", help="Build and start Hermes Research")
    up.add_argument("--without-docling", action="store_true", help="Start without structured PDF extraction")
    up.set_defaults(func=command_up)

    down = subparsers.add_parser("down", help="Stop Hermes Research without deleting reviews")
    down.set_defaults(func=command_down)

    logs = subparsers.add_parser("logs", help="Show runtime logs")
    logs.add_argument("--tail", type=int, default=200, help="Number of lines per service")
    logs.add_argument("--follow", action="store_true", help="Continue following new log lines")
    logs.set_defaults(func=command_logs)

    smoke = subparsers.add_parser("smoke-test", help="Run the public smoke test")
    smoke.set_defaults(func=command_smoke_test)

    multimodal = subparsers.add_parser(
        "multimodal-test",
        help="Verify PDF extraction, page rendering, and visual model reading",
    )
    multimodal.set_defaults(func=command_multimodal_test)

    docling = subparsers.add_parser(
        "docling-test",
        help="Validate structured PDF, table, figure, and OCR extraction",
    )
    docling.set_defaults(func=command_docling_test)

    cleanroom = subparsers.add_parser("cleanroom-validate", help="Validate a fresh clean-room copy of the bundle")
    cleanroom.set_defaults(func=command_cleanroom_validate)

    release = subparsers.add_parser("release-bundle", help="Create a sanitized distributable ZIP")
    release.set_defaults(func=command_release_bundle)

    verify_release = subparsers.add_parser("verify-release", help="Verify the latest release ZIP in a temporary folder")
    verify_release.add_argument("zip_path", nargs="?", help="Optional explicit ZIP path to verify")
    verify_release.set_defaults(func=command_verify_release)

    ship_release = subparsers.add_parser("ship-release", help="Sync, package, and verify a full release artifact")
    ship_release.set_defaults(func=command_ship_release)

    init = subparsers.add_parser("init", help="Create a new review from a small intake")
    init.add_argument("--topic", help="Review topic")
    init.add_argument("--years", help="Year or year range, e.g. 2025-2026")
    init.add_argument("--include", help="Inclusion criteria")
    init.add_argument("--exclude", help="Exclusion criteria")
    init.add_argument("--question", help="Optional research question")
    init.add_argument("--from-date", help="Optional exact start date (YYYY-MM-DD)")
    init.add_argument("--to-date", help="Optional exact end date (YYYY-MM-DD)")
    init.add_argument("--authors", help="Optional author filter")
    init.add_argument("--autonomous", default="sí", help="Autonomous mode flag (default: sí)")
    init.add_argument(
        "--final-n",
        default="37",
        help="Exact or ranged final N, e.g. 37 or 23-63 (default: 37)",
    )
    init.add_argument("--outlet", default="generic-common-core", help="Target outlet (default: generic-common-core)")
    init.add_argument("--representativeness", help="Optional representativeness rule")
    init.add_argument("--target-length", help="Optional target manuscript length")
    init.set_defaults(func=command_init)

    status = subparsers.add_parser("status", help="Show the status of a review")
    status.add_argument("review", nargs="?", help="Optional review path or name")
    status.add_argument("--format", choices=("markdown", "json"), default="markdown")
    status.set_defaults(func=command_status)

    run = subparsers.add_parser("run", help="Run a review pipeline")
    run.add_argument("review", nargs="?", help="Review path or name. Defaults to the latest review.")
    run.add_argument("--background", action="store_true", help="Launch the pipeline in the background")
    run.add_argument(
        "--skip-publication-layer",
        action="store_true",
        help="Run only the PRISMA/extraction pipeline",
    )
    run.set_defaults(func=command_run)

    resume = subparsers.add_parser("resume", help="Resume a review pipeline")
    resume.add_argument("review", nargs="?", help="Review path or name. Defaults to the latest review.")
    resume.add_argument("--foreground", action="store_true", help="Run in the foreground instead of the background")
    resume.add_argument(
        "--skip-publication-layer",
        action="store_true",
        help="Run only the PRISMA/extraction pipeline",
    )
    resume.set_defaults(func=command_resume)

    package = subparsers.add_parser("package", help="Refresh the final publication bundle")
    package.add_argument("review", nargs="?", help="Review path or name. Defaults to the latest review.")
    package.add_argument("--autopilot", action="store_true", help="Run publication_autopilot.py before packaging")
    package.set_defaults(func=command_package)

    return parser


def main(argv: Iterable[str] | None = None) -> int:
    """Parse arguments, load the package environment, and dispatch the command."""

    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    env = load_package_env()
    return int(args.func(args, env))


if __name__ == "__main__":
    raise SystemExit(main())
