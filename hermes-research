def ensure_exists(path: Path, label: str) -> None:
    """Fail fast with a user-facing message when a required file is missing."""

    if not path.exists():
        raise SystemExit(f"Missing {label}: {path}")


def run_command(command: list[str], *, env: dict[str, str], cwd: Path | None = None) -> int:
    """Run a foreground command while streaming output to the terminal."""

    completed = subprocess.run(command, cwd=str(cwd) if cwd else None, env=env, check=False)
    return completed.returncode


def record_pipeline_transition(
    review_dir: Path,
    step_id: str,
    *,
    status: str,
    inputs: Iterable[str],
    outputs: Iterable[str],
    detail: str = "",
) -> None:
    """Record direct CLI work in the same lineage used by the autopilot."""
    scripts_dir = str(prisma_script("pipeline_state.py").parent)
    inserted = scripts_dir not in sys.path
    if inserted:
        sys.path.insert(0, scripts_dir)
    try:
        from pipeline_state import record_step

        record_step(
            review_dir,
            step_id,
            status=status,
            inputs=inputs,
            outputs=outputs,
            detail=detail,
        )
    finally:
        if inserted:
            sys.path.remove(scripts_dir)


def run_tracked_review_step(
    review_dir: Path,
    step_id: str,
    *,
    inputs: Iterable[str],
    outputs: Iterable[str],
    runner: Callable[[], int],
) -> int:
    """Run a direct review command without losing resumability or lineage."""
    input_patterns = list(inputs)
    output_paths = list(outputs)
    record_pipeline_transition(
        review_dir,
        step_id,
        status="running",
        inputs=input_patterns,
        outputs=output_paths,
    )
    try:
        returncode = runner()
    except Exception as exc:
        record_pipeline_transition(
            review_dir,
            step_id,
            status="failed",
            inputs=input_patterns,
            outputs=output_paths,
            detail=str(exc),
        )
        raise
    record_pipeline_transition(
        review_dir,
        step_id,
        status="completed" if returncode == 0 else "failed",
        inputs=input_patterns,
        outputs=output_paths,
        detail="" if returncode == 0 else f"Command exited with status {returncode}.",
    )
    return returncode


def is_truthy(value: str | None) -> bool:
    """Interpret public yes/no style values with a generous truthy set."""

    normalized = (value or "").strip().lower()
    return normalized not in {"", "no", "n", "false", "0", "off"}


def bundle_container_name(env: dict[str, str]) -> str | None:
    """Return the public Hermes container name when it matches this bundle.

    The public wrapper should prefer the running Docker runtime for heavy PRISMA
    work. That keeps host-side dependencies small and makes the package behave
    more like a product than a loose pile of local scripts.
    """

    data_dir = package_path(env.get("HERMES_DATA_DIR", "./runtime/hermes-home"), env).resolve()
    workspace_dir = workspace_root(env).resolve()
    container_name = env.get("HERMES_CONTAINER_NAME", "hermes-agent").strip() or "hermes-agent"
    inspected = subprocess.run(
        ["docker", "inspect", container_name],
        text=True,
        capture_output=True,
        check=False,
    )
    if inspected.returncode != 0:
        return None
    try:
        payload = json.loads(inspected.stdout)
    except json.JSONDecodeError:
        return None
    if not payload:
        return None
    container = payload[0]
    if not container.get("State", {}).get("Running"):
        return None
    mounts = container.get("Mounts", [])
    mapped = {item.get("Destination"): Path(item.get("Source", "")).resolve() for item in mounts}
    if mapped.get("/opt/data") != data_dir:
        return None
    if mapped.get("/workspace") != workspace_dir:
        return None
    return container_name


def container_review_dir(review_dir: Path, env: dict[str, str]) -> str:
    """Map a host review path to the mounted /workspace path inside the runtime."""

    relative = review_dir.resolve().relative_to(workspace_root(env).resolve())
    return str(Path("/workspace") / relative)


def bundle_container_for_review(review_dir: Path, env: dict[str, str]) -> str | None:
    """Use Docker only when the requested review is inside its workspace mount."""

    container_name = bundle_container_name(env)
    if not container_name:
        return None
    try:
        review_dir.resolve().relative_to(workspace_root(env).resolve())
    except ValueError:
        return None
    return container_name


def review_workspace_root(review_dir: Path, env: dict[str, str]) -> Path:
    """Use the configured workspace, or the review parent for external paths."""

    configured_root = workspace_root(env).resolve()
    try:
        review_dir.resolve().relative_to(configured_root)
    except ValueError:
        return review_dir.resolve().parent
    return configured_root


