    amendment.set_defaults(func=command_amendment)

    disagreements = subparsers.add_parser(
        "disagreements",
        help="Show DOI-level full-text eligibility conflicts",
    )
    disagreements.add_argument(
        "review",
        nargs="?",
        help="Review path or name. Defaults to the latest review.",
    )
    disagreements.set_defaults(func=command_disagreements)

    resolve_screening = subparsers.add_parser(
        "resolve-screening",
        help="Sign one full-text eligibility decision and resume when complete",
    )
    resolve_screening.add_argument(
        "review",
        nargs="?",
        help="Review path or name. Defaults to the latest review.",
    )
    resolve_screening.add_argument("--doi", required=True)
    resolve_screening.add_argument(
        "--decision",
        choices=("include", "exclude"),
        required=True,
    )
    resolve_screening.add_argument(
        "--reason",
        required=True,
        help="Scientific justification for this eligibility decision",
    )
    resolve_screening.add_argument(
        "--skip-publication-layer",
        action="store_true",
        help="Resume only the PRISMA/extraction pipeline",
    )
    resolve_screening.set_defaults(func=command_resolve_screening)

    return parser


def main(argv: Iterable[str] | None = None) -> int:
    """Parse arguments, load the package environment, and dispatch the command."""

    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    env = load_package_env()
    return int(args.func(args, env))


if __name__ == "__main__":
    raise SystemExit(main())
