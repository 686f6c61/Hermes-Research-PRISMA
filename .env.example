# Base image / git ref used by the local Docker build.
HERMES_SOURCE_REF=v2026.7.20
HERMES_SOURCE_COMMIT=3ef6bbd201263d354fd83ec55b3c306ded2eb72a
HERMES_IMAGE_TAG=v2026.7.20-public

# Default timezone for logs and scheduled checks.
TZ=Europe/Madrid

# Public operating mode: cli, telegram, or both.
HERMES_INSTALL_MODE=both
HERMES_UID=1000
HERMES_GID=1000

# Optional Compose project name. Set this when one Docker host needs to run
# more than one Hermes bundle without project-level collisions.
COMPOSE_PROJECT_NAME=

# Telegram public entrypoint.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot.
# The guided setup discovers candidates after the owner sends /start.
TELEGRAM_ALLOWED_USERS=
# Direct-message chat used by the watchdog and research notifications.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_PRISMA_CHAT_ID=
HERMES_TELEGRAM_PUBLIC_MENU_ONLY=1
# Prefer the standard Telegram hostname. The fallback-IP transport is useful
# on filtered networks but can stall initialization on otherwise healthy hosts.
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=1

# Remote OpenAI-compatible inference provider. Run `./hermes-research setup`
# instead of committing real values to this file.
HERMES_INFERENCE_API_KEY=
HERMES_INFERENCE_BASE_URL=
HERMES_MODEL_PRIMARY=
HERMES_MODEL_VISION=
HERMES_MODEL_REVIEW=

# Scholarly-source identity and optional higher-rate credentials. OpenAlex,
# Crossref, OpenAIRE, Europe PMC and arXiv do not need keys for normal use.
HERMES_CONTACT_EMAIL=
HERMES_UNPAYWALL_EMAIL=
HERMES_ENABLE_SEMANTIC_SCHOLAR=1
HERMES_SEMANTIC_SCHOLAR_API_KEY=
HERMES_LENS_API_KEY=
HERMES_NCBI_EMAIL=
HERMES_NCBI_API_KEY=

# Host-side paths mounted into the containers.
HERMES_DATA_DIR=./runtime/hermes-home
HERMES_WORKSPACE_DIR=./runtime/workspace
OBSIDIAN_VAULT_HOST_PATH=./runtime/obsidian

# Optional container names. Override these if you want to run this bundle
# alongside another Hermes installation on the same Docker host.
HERMES_CONTAINER_NAME=hermes-agent
HERMES_WATCHDOG_CONTAINER_NAME=hermes-prisma-watchdog

# Public PRISMA workspace inside the container.
HERMES_PUBLIC_REVIEW_WORKSPACE=/workspace

# Watchdog tuning.
PRISMA_WATCHDOG_INTERVAL_SECONDS=300
PRISMA_WATCHDOG_STALLED_MINUTES=15
PRISMA_WATCHDOG_COOLDOWN_MINUTES=30
PRISMA_WATCHDOG_AGENT_TIMEOUT_SECONDS=3600
PRISMA_WATCHDOG_MODELS=

# Structured PDF extraction. Docling runs in a separate CPU-only container so
# PyTorch and document models never enlarge the Hermes gateway image.
HERMES_DOCLING_ENABLED=auto
DOCLING_SERVE_URL=http://docling:5001
DOCLING_CONTAINER_NAME=hermes-docling
DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu@sha256:1ef1991ec5aa494c21dd3f509e5effada493b44fdcf0ec28697d279dc060be81
HERMES_DOCLING_DOCUMENT_TIMEOUT=180
HERMES_DOCLING_MAX_FILE_MB=50
HERMES_DOCLING_DOCUMENT_LIMIT=0
DOCLING_NUM_THREADS=4
DOCLING_PERF_PAGE_BATCH_SIZE=2
DOCLING_SERVE_MAX_FILE_SIZE=52428800
DOCLING_SERVE_MAX_NUM_PAGES=200
DOCLING_SERVE_MAX_DOCUMENT_TIMEOUT=240
DOCLING_SERVE_MAX_SYNC_WAIT=210
